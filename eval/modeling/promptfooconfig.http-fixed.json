{
  "description": "Corrected HTTP output adapter; existing completed observations are replayed by the service",
  "prompts": [
    "{{case_id}} {{variant}}"
  ],
  "providers": [
    {
      "id": "http",
      "config": {
        "url": "http://127.0.0.1:8005/evaluate",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "case_id": "{{case_id}}",
          "variant": "{{variant}}"
        },
        "transformResponse": "({output: json})",
        "timeout": 240000
      }
    }
  ],
  "tests": "file://tests.json",
  "defaultTest": {
    "assert": [
      {
        "type": "javascript",
        "value": "file://checks.cjs"
      }
    ]
  }
}
